# ==============================================================================
# ORCA MARINE INTELLIGENCE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required credentials.
# NEVER commit .env to version control or expose keys in frontend code.
# ==============================================================================

# ------------------------------------------------------------------------------
# Bhashini Multilingual & Voice Integration Credentials
# ------------------------------------------------------------------------------
# Bhashini / ULCA User ID (obtained from Bhashini ULCA profile)
BHASHINI_USER_ID=your_bhashini_user_id_here

# Bhashini UDYAT / ULCA API Key for pipeline discovery
BHASHINI_UDYAT_KEY=your_bhashini_udyat_key_here

# Bhashini Inference API Key (for pipeline execution authorization)
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here

# Optional: Dedicated Bhashini Pipeline ID (default is the standard multi-task pipeline)
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# ------------------------------------------------------------------------------
# Google Gemini Conversational Synthesis (Optional - Deterministic Fallback used if omitted)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash
GEMINI_RETRIES=2
GEMINI_RETRY_DELAY=2.0

# ------------------------------------------------------------------------------
# Frontend / Network Configuration
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
